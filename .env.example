# Plantilla de credenciales. Uso: cp .env.example .env  y completa tus keys.
# .env está en .gitignore; este archivo sí se commitea, así que nunca pongas
# valores reales aquí. Una variable exportada en la terminal tiene prioridad
# sobre la del .env.

# Requerida por casi todos los ejemplos (Gemini directo o vía LiteLLM).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional: backend Claude por SDK en examples/llm.py (si no hay GEMINI_API_KEY)
# y la fila "Claude" de los ejemplos LiteLLM. Sin ninguna key, llm.py usa `claude -p`.
# ANTHROPIC_API_KEY=

# Opcional: solo si activas la ruta OpenAI comentada en examples/10-router-litellm.
# OPENAI_API_KEY=

# Opcional: fuerza el backend de examples/llm.py (gemini | sdk | cli | fake).
# LLM_BACKEND=
